# Copy to .env and fill in. Do NOT commit .env.

# --- App ---
APP_ENV=development
# Only needed if the frontend is ever hosted separately from this API
# (comma-separated origins) — the default same-origin SPA serving needs none.
CORS_ORIGINS=
# Absolute path to frontend/dist — required once the app is `pip install`-ed
# rather than run from the source checkout (the Dockerfile sets this).
FRONTEND_DIST=

# --- LLM (reasoning / agent) — pluggable provider. No key required. ---
# "auto" (default): uses a hosted key if set, otherwise the LOCAL Ollama model
# (zero cost, zero key — `docker compose up -d` starts it), otherwise runs in
# offline retrieval-only mode. Explicit: "gemini" | "anthropic" | "openrouter" |
# "alibaba" | "aihubmix" | "ollama".
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic (used only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# AIHubMix — OpenAI-compatible aggregator, one key routes to many hosted
# models (GLM, Qwen, OpenAI, Claude, ...) via a single fixed public endpoint.
# minimax-m3-free is confirmed genuinely free (AIHubMix's own catalog: input/
# output/cache_read all $0), 1M+ context. Paid models (e.g. glm-5.3-flash,
# ~$0.11/$0.39 per M in/out tokens) work the same way, just cost real money.
AIHUBMIX_API_KEY=
AIHUBMIX_MODEL=minimax-m3-free
# Z.AI (Zhipu) direct API — cheapest real GLM tier: glm-5.3-flash is
# $0.075/$0.25 per M in/out tokens (confirmed live). Always reasons (Z.AI's
# own docs: disabling it is "no longer supported") — _call_zai pads the
# token budget and sets reasoning_effort=low to compensate.
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
# Local, API-key-free LLM. First `docker compose up -d` pulls the model (~5 GB).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Ingestion (Phase 1) ---
TARGET_REPO_URL=https://github.com/pallets/flask
# Read-only GitHub PAT (classic, no scopes needed for public repos) for issues/PRs.
GITHUB_TOKEN=

# --- Embeddings ---
# NOTE: Anthropic has no first-party embeddings API. We decide the provider
# in Phase 3 (hybrid retrieval). Placeholder below; leave blank for now.
# "local" (default) loads a real model into this process — tight on a
# free-tier/memory-constrained deploy. "alibaba"/"aihubmix" reuse the
# matching *_API_KEY above with no in-process model. "voyage" is hosted too,
# but its free tier is heavily rate-limited.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
ALIBABA_EMBEDDING_MODEL=text-embedding-v3
ALIBABA_EMBEDDING_DIM=1024
# Reuses AIHUBMIX_API_KEY above. jina-embeddings-v2-base-code is code-tuned;
# its dim (768, Jina's own published spec) is set here but NOT yet verified
# live against AIHubMix — confirm with a real call before relying on it.
AIHUBMIX_EMBEDDING_MODEL=jina-embeddings-v2-base-code
AIHUBMIX_EMBEDDING_DIM=768
# Reuses OPENROUTER_API_KEY above. The free default is confirmed live: 1024
# dims, genuinely $0 — but hard-errors past 512 tokens/input (not a silent
# truncation), so long code symbols get embedded on their opening portion only.
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_EMBEDDING_DIM=1024

# --- Postgres ---
# Host port 5433 to avoid a common clash with a native Postgres already on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=archaeologist
POSTGRES_PASSWORD=archaeologist
# Only needed for hosted Postgres (Neon, Supabase, ...) — e.g. "require".
POSTGRES_SSLMODE=
POSTGRES_DB=archaeologist

# --- OpenSearch ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
# Only needed for a hosted OpenSearch (e.g. Bonsai's free tier) that requires
# basic auth — leave blank for the local Docker instance.
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379


# --- Confluence Cloud publish / Jira Cloud tickets (Phase 8) ---
# Credentials themselves are per-user now (Settings page in the app, Phase 4
# of the multi-user migration) — each user connects their own Confluence
# space / Jira project. Only operator-level, non-secret config stays here.
# Render Mermaid diagrams to PNG via mermaid.ink (sends diagram SOURCE, not
# secrets, to a third party). false = always fall back to a code macro.
CONFLUENCE_RENDER_DIAGRAMS=true
CONFLUENCE_MERMAID_INK_URL=https://mermaid.ink

# Encrypts every user's saved Confluence/Jira API tokens at rest. Generate:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
